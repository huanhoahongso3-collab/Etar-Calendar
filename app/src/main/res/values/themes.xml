<?xml version="1.0" encoding="utf-8"?>

<resources>

    <!-- Base application theme — built on the OneUI (SESL8) design system's base
         theme so the app inherits Samsung One UI's widget styles, colors and
         typography. See https://github.com/tribalfs/oneui-design -->
    <style name="BaseTheme" parent="OneUITheme">
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <item name="android:statusBarColor">?android:colorBackground</item>
        <item name="android:navigationBarColor">?android:colorBackground</item>

        <!-- Material3 color roles: our theme is AppCompat/OneUITheme-based,
             not Theme.MaterialComponents, but com.google.android.material
             widgets (MaterialAlertDialogBuilder, MaterialSwitch, etc.) still
             query these attrs directly and crash with
             IllegalArgumentException if they're unset — they don't fall
             back gracefully just because the parent theme isn't MDC. -->
        <item name="colorSurface">?android:attr/colorBackground</item>
        <item name="colorOnSurface">?android:attr/textColorPrimary</item>
        <item name="colorSurfaceVariant">?android:attr/colorBackground</item>
        <item name="colorOnSurfaceVariant">?android:attr/textColorSecondary</item>
        <item name="colorOutline">@color/month_grid_lines</item>
        <item name="colorOutlineVariant">@color/month_grid_lines</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/colorSecondaryContainer</item>
        <item name="colorOnPrimaryContainer">?android:attr/textColorPrimary</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorError">#ffb4ab</item>
        <item name="colorOnError">#690005</item>

        <!-- MaterialAlertDialogBuilder reads this attr (not
             alertDialogTheme) to pick its own theme overlay, which is what
             gives it rounded corners; without it some dialogs render with
             square AppCompat corners. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog</item>
    </style>

    <!-- Inherit base theme to allow overriding Light Theme as per API levels -->
    <style name="Theme.Etar" parent="BaseTheme">
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Applied at runtime on top of Theme.Etar to swap the accent color for
         the Samsung OneUI signature blue. -->
    <style name="OneUiAccentOverlay" parent="">
        <item name="colorAccent">@color/oneui_primary</item>
        <item name="colorPrimary">@color/oneui_primary</item>
    </style>

    <!-- One UI drawer menu items are large rounded-corner pills. -->
    <style name="OneUiDrawerItemShape">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="OneUiDrawerItemText" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textSize">17sp</item>
    </style>

    <!-- One UI-style rounded outline button, built on plain AppCompat so it
         doesn't need Material3 theme attrs to render (unlike
         Widget.Material3.Button.OutlinedButton / .TextButton, which throw
         IllegalArgumentException under a non-MaterialComponents theme). -->
    <style name="OneUiOutlinedButton" parent="Widget.AppCompat.Button.Borderless.Colored">
        <item name="android:textColor">@color/oneui_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">@drawable/oneui_about_button_background</item>
    </style>

    <!-- About screen's link actions (Source/Changelog/Report issues). -->
    <style name="OneUiAboutLinkButton" parent="OneUiOutlinedButton">
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="CalendarAppThemeLightTeal" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:itemBackground">@android:color/white</item>
        <item name="autoCompleteTextViewStyle">@style/actionbar_cursor</item>
        <item name="calendarSpinnerDisabledTextColor">@color/calendar_item_disabled</item>
    </style>

    <style name="CalendarAppThemeDarkTeal" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.AppCompat.Dark</item>
        <item name="android:itemBackground">@color/bg_dark</item>
        <item name="calendarSpinnerDisabledTextColor">@color/calendar_item_disabled_dark</item>
    </style>

    <style name="CalendarAppThemeBlackTeal" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/bg_black</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/bg_black</item>
        <item name="android:itemBackground">@color/bg_black</item>
        <item name="calendarSpinnerDisabledTextColor">@color/calendar_item_disabled_black</item>
    </style>

</resources>
